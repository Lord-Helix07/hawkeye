# Environment for the Hawkeye API on the EC2 server.
# setup_server.sh copies this to /etc/hawkeye/hawkeye.env -- edit THAT copy on
# the server, not this file. Never put AWS access keys here: the EC2 instance's
# IAM role gives boto3 its DynamoDB permissions automatically.

# Region your DynamoDB tables live in (match what you see in the AWS console).
AWS_REGION=us-east-1

# Table names (these are the defaults the code already uses).
MISSIONS_TABLE=Missions
USERS_TABLE=Users
USERS_EMAIL_INDEX_TABLE=UsersByEmail

# Optional: name of the Lambda launch_drone.py should invoke. Leave blank to skip.
HAWKEYE_LAMBDA_FUNCTION=

# Leave DYNAMODB_ENDPOINT_URL unset on the server -- it's only for DynamoDB Local.

# Keep YOLO's settings/cache in a writable place.
YOLO_CONFIG_DIR=/home/ubuntu/.config/Ultralytics
